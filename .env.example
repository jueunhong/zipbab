# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
# 배포할 때는 같은 이름으로 Vercel → Settings → Environment Variables 에 넣으세요.

# Claude API — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase — 대시보드 → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 사용자별 하루 AI 사용 횟수 (레시피 추천 + 영양 계산, 기본 10)
RECIPE_DAILY_LIMIT=10
# 횟수 제한 없이 쓸 관리자 이메일 (구글 로그인 이메일, 쉼표로 여러 개)
ADMIN_EMAILS=

# 네이버 이미지 검색 (레시피 참고 사진). 둘 중 하나만 넣으면 됨
# NAVER API HUB (네이버 클라우드 콘솔)
NCP_API_HUB_CLIENT_ID=
NCP_API_HUB_CLIENT_SECRET=
# 또는 네이버 개발자센터 (developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
